<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= event.title %> — Campus Event</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <main>
      <p><a href="/">All events</a></p>
      <h1><%= event.title %></h1>
      <p><strong>Starts:</strong> <%= event.starts_at %></p>
      <p><strong>Places remaining:</strong> <%= event.remaining %></p>
      <% if (message) { %>
        <p class="message"><%= message %></p>
      <% } %>
      <h2>Reserve a place</h2>
      <form method="post" action="/events/<%= event.id %>/reservations">
        <label>
          Student ID
          <input name="studentId" required>
        </label>
        <label>
          Email
          <input name="email" type="email" required>
        </label>
        <button type="submit">Reserve</button>
      </form>
    </main>
  </body>
</html>
